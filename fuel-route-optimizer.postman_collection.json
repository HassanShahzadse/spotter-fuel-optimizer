{
	"info": {
		"name": "Fuel Route Optimizer API",
		"description": "Route + cost-optimal fuel stops (500 mi range, 10 MPG). Set base_url to your server.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Route planning",
			"item": [
				{
					"name": "Plan route — New York → Los Angeles",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/route/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"route",
								""
							]
						},
						"description": "Coast-to-coast: multiple fuel stops. Run twice to see meta.cached = true.",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"start\": \"New York, NY\",\n  \"finish\": \"Los Angeles, CA\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"const d = pm.response.json();",
									"pm.collectionVariables.set('plan_id', d.map_url.split('/route/')[1].split('/')[0]);",
									"pm.test('has fuel stops + total cost', () => { pm.expect(d).to.have.property('total_fuel_cost'); pm.expect(d.fuel_stops).to.be.an('array'); });",
									"pm.test('at most 1 routing API call', () => pm.expect(d.meta.routing_api_calls).to.be.at.most(1));",
									"console.log('Total fuel cost: $' + d.total_fuel_cost + ' | stops: ' + d.fuel_stops.length + ' | map: ' + d.map_url);"
								]
							}
						}
					]
				},
