# Local settings. Copy this file to .env (git-ignored) and add your ORS key below.

# Routing API key: create a free one at https://openrouteservice.org/dev/#/signup
# If left empty, the app falls back to the public OSRM demo server (no key, but slower and rate limited).
ORS_API_KEY=

DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Vehicle (defaults from the assignment)
VEHICLE_MAX_RANGE_MILES=500
VEHICLE_MPG=10

# Only used for street-address lookups without an ORS key: Nominatim requires a contact email.
# HTTP_USER_AGENT=fuel-route-optimizer/1.0 (you@example.com)
